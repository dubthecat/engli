# Engli stdlib: learn — a tiny Education module for teaching Engli.
# Reusable course components (lessons, code blocks, a syllabus), built on the
# web stack and pinned to the running language version via langinfo.
Import extend, content, nav, hero, grid, markdown, link, paragraph from "web".
Import replace from "text".
Import module "langinfo" as info.

# ---- helpers ---------------------------------------------------------------
Export Define function escape taking s as text giving text:
    Let out be replace(s, "&", "&amp;").
    Set out to replace(out, "<", "&lt;").
    Set out to replace(out, ">", "&gt;").
    Return out.
End.

Export Define function codeblock taking code as text giving text:
    Return "<pre class=\"code\"><code>" plus escape(code) plus "</code></pre>".
End.

# A single lesson: a heading, a Markdown explanation, the Engli code, and the
# real output it produces (shown as a result chip; pass "" to omit it).
Export Define function lesson taking title as text, body as text, code as text, shows as text giving text:
    Let out be "<section class=\"lesson\"><h2>" plus title plus "</h2>".
    Set out to out plus markdown(body).
    Set out to out plus codeblock(code).
    If shows is not equal to "":
        Set out to out plus "<div class=\"shows\"><span>shows</span><code>" plus escape(shows) plus "</code></div>".
    End.
    Return out plus "</section>".
End.

# A syllabus card linking to one lesson's page.
Export Define function lesson_card taking title as text, summary as text, href as text giving text:
    Return "<a class=\"lcard\" href=\"" plus href plus "\"><h3>" plus title plus "</h3><p>" plus summary plus "</p></a>".
End.

Export Define function syllabus taking cards as list of text giving text:
    Return grid(cards).
End.

# Extra styles layered on top of the web stack's baked CSS.
Define function learn_css giving text:
    Return "<style>.lesson{background:var(--card);border:1px solid var(--line);border-radius:1.1rem;padding:1.5rem 1.8rem;margin:0 0 1.6rem;box-shadow:0 1px 2px rgba(60,40,30,.05)}.lesson h2{margin-top:0;font-size:1.6rem}pre.code{background:#241c16;color:#f4ece2;padding:1rem 1.2rem;border-radius:.8rem;overflow:auto;font-size:.95rem;line-height:1.55;margin:1rem 0}pre.code code{background:none;color:inherit;padding:0}.shows{display:flex;align-items:center;gap:.6rem;font-size:.95rem}.shows span{font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:700}.shows code{background:#e9f6ee;color:#1f7a4d;padding:.22em .6em;border-radius:.4em}.lcard{display:block;background:var(--card);border:1px solid var(--line);border-radius:1rem;padding:1.3rem 1.4rem;text-decoration:none;color:inherit;transition:transform .15s ease,box-shadow .15s ease}.lcard:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(210,120,60,.16)}.lcard h3{margin:.1rem 0 .35rem;font-size:1.2rem}.lcard p{margin:0;color:var(--muted)}@media(prefers-color-scheme:dark){.shows code{background:#13311f;color:#7fd3a3}}</style>".
End.

# The full course page: nav + styled body + a footer pinned to the version.
Export Define function course_page taking title as text, menu as text, body as text giving text:
    Let footer be "<footer class=\"foot\"><div class=\"wrap\">Learn Engli · " plus info's badge() plus "</div></footer>".
    Return extend({ "title": title, "nav": menu, "body": learn_css() plus body, "footer": footer }).
End.
