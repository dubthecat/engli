# Engli stdlib: web — build a beautiful website in plain English.
# HTML builders are pure Engli; file IO, serving, and Markdown use the runtime.
Import module "webruntime" as rt.
Import get from "records".

# ---- inline elements -------------------------------------------------------
Export Define function heading taking text as text giving text:
    Return "<h1>" plus text plus "</h1>".
End.
Export Define function subheading taking text as text giving text:
    Return "<h2>" plus text plus "</h2>".
End.
Export Define function paragraph taking text as text giving text:
    Return "<p>" plus text plus "</p>".
End.
Export Define function link taking text as text, href as text giving text:
    Return "<a href=\"" plus href plus "\">" plus text plus "</a>".
End.
Export Define function image taking src as text, alt as text giving text:
    Return "<img src=\"" plus src plus "\" alt=\"" plus alt plus "\">".
End.
Export Define function button taking text as text giving text:
    Return "<a class=\"btn\" href=\"#\">" plus text plus "</a>".
End.
Export Define function section taking inner as text giving text:
    Return "<section>" plus inner plus "</section>".
End.
Export Define function join taking parts as list of text giving text:
    Return ""'s join(parts).
End.
Export Define function bullets taking items as list of text giving text:
    Let html be "<ul>".
    For each item in items:
        Set html to html plus "<li>" plus item plus "</li>".
    End.
    Return html plus "</ul>".
End.

# ---- layout blocks ---------------------------------------------------------
Export Define function nav taking brand as text, links as list of text giving text:
    Return "<nav class=\"nav\"><div class=\"wrap nav-inner\"><a class=\"brand\" href=\"index.html\">" plus brand plus "</a><div class=\"links\">" plus ""'s join(links) plus "</div></div></nav>".
End.
Export Define function hero taking title as text, subtitle as text giving text:
    Return "<header class=\"hero\"><div class=\"wrap\"><h1>" plus title plus "</h1><p class=\"lede\">" plus subtitle plus "</p></div></header>".
End.
Export Define function card taking title as text, body as text giving text:
    Return "<article class=\"card\"><h3>" plus title plus "</h3><div class=\"card-body\">" plus body plus "</div></article>".
End.
Export Define function photo taking src as text, alt as text, caption as text giving text:
    Return "<article class=\"card photo\"><img src=\"" plus src plus "\" alt=\"" plus alt plus "\"><div class=\"card-body\"><p>" plus caption plus "</p></div></article>".
End.
Export Define function grid taking items as list of text giving text:
    Return "<div class=\"grid\">" plus ""'s join(items) plus "</div>".
End.
Export Define function content taking inner as text giving text:
    Return "<main><div class=\"wrap\">" plus inner plus "</div></main>".
End.

# ---- the full, styled document --------------------------------------------
Export Define function doc taking title as text, body as text giving text:
    Let css be "@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;600&display=swap');:root{--bg:#fdf6ee;--ink:#3b2f2a;--muted:#7a6a60;--card:#fffdfa;--accent:#e8743b;--accent2:#f4a261;--line:#efe2d4}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.65}.wrap{max-width:68rem;margin:0 auto;padding:0 1.25rem}h1,h2,h3{font-family:Fraunces,Georgia,serif;line-height:1.1;margin:.2em 0}.nav{position:sticky;top:0;z-index:10;background:rgba(253,246,238,.85);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}.nav-inner{display:flex;align-items:center;justify-content:space-between;height:4rem}.brand{font-family:Fraunces,serif;font-weight:700;font-size:1.3rem;color:var(--ink);text-decoration:none}.links{display:flex;gap:1.4rem}.links a{color:var(--muted);text-decoration:none;font-weight:600}.links a:hover{color:var(--accent)}.hero{background:radial-gradient(1200px 400px at 50% -50%,#ffe6d2,transparent),linear-gradient(180deg,#fff2e6,var(--bg));text-align:center;padding:5rem 0 3.5rem}.hero h1{font-size:clamp(2.6rem,6vw,4.4rem);letter-spacing:-.02em}.lede{font-size:1.25rem;color:var(--muted);max-width:34rem;margin:1rem auto 0}main{padding:3rem 0}main .wrap>h2{font-size:2rem;margin-bottom:1.2rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));gap:1.5rem}.card{background:var(--card);border:1px solid var(--line);border-radius:1.1rem;padding:1.5rem;box-shadow:0 1px 2px rgba(60,40,30,.05);transition:transform .15s ease,box-shadow .15s ease}.card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(210,120,60,.16)}.card h3{font-size:1.35rem}.card.photo{padding:0;overflow:hidden}.card.photo img{width:100%;height:220px;object-fit:cover;display:block}.card.photo .card-body{padding:1.1rem 1.4rem}.btn{display:inline-block;margin-top:1rem;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;padding:.7rem 1.4rem;border-radius:999px;text-decoration:none;font-weight:600;box-shadow:0 8px 20px rgba(232,116,59,.35)}code{background:#f0e4d6;padding:.1em .4em;border-radius:.3em;font-size:.95em}a{color:var(--accent)}.foot{border-top:1px solid var(--line);color:var(--muted);text-align:center;padding:2.5rem 0;font-size:.95rem}@media(prefers-color-scheme:dark){:root{--bg:#20160f;--ink:#f3e9df;--muted:#c3a892;--card:#2a1d14;--line:#3a2a1e}.nav{background:rgba(32,22,15,.8)}.brand{color:var(--ink)}.hero{background:radial-gradient(1200px 400px at 50% -50%,#4a2c17,transparent),linear-gradient(180deg,#2c1d12,var(--bg))}code{background:#3a2a1e}}".
    Return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>" plus title plus "</title><style>" plus css plus "</style></head><body>" plus body plus "</body></html>".
End.

# ---- template inheritance --------------------------------------------------
# A base skeleton filled from a record of named blocks; missing blocks inherit
# sensible defaults. Children override only what they need:
#   extend({ "title": "Home", "nav": ..., "body": ... })
Export Define function extend taking blocks:
    Let title be get(blocks, "title", "Untitled").
    Let navbar be get(blocks, "nav", "").
    Let body be get(blocks, "body", "").
    Let footer be get(blocks, "footer", "<footer class=\"foot\"><div class=\"wrap\">Built with Engli 🐾</div></footer>").
    Return doc(title, navbar plus body plus footer).
End.

# ---- Markdown --------------------------------------------------------------
Export Define function markdown taking md as text giving text:
    Return rt's markdown(md).
End.
Export Define function page taking title as text, md as text giving text:
    Return extend({ "title": title, "body": rt's markdown(md) }).
End.

# ---- runtime glue ----------------------------------------------------------
Export Define function save taking path as text, html as text:
    rt's write(path, html).
End.
Export Define function serve taking directory as text, port as whole:
    rt's serve(directory, port).
End.
